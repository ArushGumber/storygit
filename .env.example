# Configuration for storygit. Copy to a `.env` OUTSIDE this repository — the loader looks
# in the parent directory first — and fill in the keys. Nothing here is a secret; the
# values are placeholders.
#
# Without any keys the tool still runs: everything deterministic works, and generation
# reports that no provider is configured.

# --- Gemini: generation and judging -------------------------------------------
# Up to six free-tier keys, rotated round-robin with a per-(key, model) cooldown. Leave
# the ones you do not have blank.
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=

# Google retires model ids without notice; check these still answer before a long run.
# `scripts/smoke_live.py` is the cheapest way to find out.
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest

# --- Groq: extraction and classification --------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenRouter: locked ---------------------------------------------------------
# Deliberately disabled. It opens only when OPENROUTER_ENABLED is EXACTLY the string
# "true" -- "True", "1" and "yes" all leave it locked -- and every call must also pass
# the in-code budget guard below, which is independent of any account-side cap.
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_BUDGET_USD=12.0
OPENROUTER_MODEL=google/gemini-2.5-pro

# --- Everything else ------------------------------------------------------------
# Read-through response cache and call log. Defaults to a directory beside the repo, so
# a rerun of an evaluation costs nothing and no cache file lands in version control.
CACHE_PATH=
REQUEST_TIMEOUT_S=90
MAX_RETRIES=2
