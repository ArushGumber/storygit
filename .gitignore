# Secrets — keys live in the workspace-level .env, never in this repo
.env
*.env
# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
# Node
node_modules/
frontend/dist/
# Local caches and artifacts
.cache/
*.log
# Per-run evaluation databases: large, regenerable, and only meaningful next to the
# run log that describes them. The gallery databases ARE committed -- replay reads the
# story out of them, which is what makes a recorded session a record rather than a copy.
eval/results/runs/*.db
eval/results/runs/*.db-shm
eval/results/runs/*.db-wal
# Per-episode checkpoints. They exist so an interrupted run can resume, not so anyone
# can read them; the finished `full__*.json` beside them is the result.
eval/results/runs/*.partial.json
eval/results/gallery/*.db-shm
eval/results/gallery/*.db-wal
# TeX build junk
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
